# Skopiuj do secret/.env i wpisz własne dane. Ten plik nie zawiera poświadczeń.
DB_SERVER=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false

# Kody muszą odpowiadać rzeczywistym rekordom SystemItems i RolePermissions.
SEMESTERS_ITEM_CODE=semesters

# Istniejące źródło haseł; aplikacja nie tworzy tej tabeli ani kont.
# AccountCredentials: AccountId, PasswordHash (opcjonalnie IsActive).
# AspNetUsers: Id, PasswordHash; łączenie przez Accounts.AspNetUserId.
AUTH_DATABASE=
AUTH_SCHEMA=org
AUTH_TABLE=AccountCredentials
AUTH_PROVIDER=database
# local_file służy do jawnie utworzonych kont testowych; hashe w secret.
AUTH_LOCAL_CREDENTIALS_FILE=secret/test_accounts.json
SESSION_TTL_MINUTES=480
SESSION_IDLE_MINUTES=30
